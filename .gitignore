# Project Custom Ignores
# Exclude large dataset files (e.g. raw Reviews.csv is 300MB+)
data/reviews.csv
data/Reviews.csv

# Exclude large trained ML model binary files to keep git repository light
app/models/*.h5
app/models/*.xml
app/models/*.pkl

# Exclude temporary Kaggle download/results folders
results-*/

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini
